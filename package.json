{
  "name": "zombie-survivor",
  "private": true,
  "version": "0.0.0",
  "description": "A browser-based 2D zombie survivor roguelite built with TypeScript, Vite, Canvas 2D, and a custom ECS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhzz-svg/zombie-survivor.git"
  },
  "homepage": "https://github.com/hhzz-svg/zombie-survivor#readme",
  "bugs": {
    "url": "https://github.com/hhzz-svg/zombie-survivor/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "balance": "vite-node tools/balance.ts",
    "i18n:audit": "vite-node tools/i18nAudit.ts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
